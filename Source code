package rockpaper1;

import java.util.*;
import java.util.Random;

class draw{
   
  public void game() {
   System.out.println("0= rock , 1= paper , 2= Scissor");
   
   Scanner sc = new Scanner(System.in);
   Random scc = new Random();
   
   for (int i =0; i<=5 ;i++) {
	   System.out.println("please enter your input");
	   
	   int user =  sc.nextInt();
	   int comp =  scc.nextInt(3);
	   
	   if(user>2) {
		   System.out.println("error please choose right info");
	   }
	   else {
		   System.out.println("computer choose "+comp);
		   if(user==comp) {
			   System.out.println("Game Draw");
			   
		   }
		   else if(user==0 && comp==2 || user==1 && comp==0 || user==2 && comp==1 ) {
			   System.out.println("----you won bro------");
			   
		   }
		   
		   else {
			   System.out.println("-----you loose bro-----");
		   }
	   }
	  
   }
  }
   
}

public class Rockpaperscissor {
	
	public static void main (String[] args) {
	draw bc = new draw();
	bc.game();
	}

}

